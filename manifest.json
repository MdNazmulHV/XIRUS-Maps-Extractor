{
  "manifest_version": 3,
  "name": "XIRUS Maps Extractor",
  "version": "3.0",
  "description": "Chronological extraction engine with metadata logging and raw media retrieval.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Launch XIRUS"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Command+Shift+X"
      },
      "description": "Run XIRUS Extractor"
    }
  },
  "host_permissions": [
    "https://*/*"
  ]
}